{
  "name": "@zaydiscold/amazon-kindle-cli",
  "version": "0.1.0",
  "description": "Kindle-first Amazon CLI + API map: Send to Kindle, wishlists, content devices, Goodreads bridge.",
  "type": "module",
  "bin": { "amazon-kindle-cli": "dist/index.js" },
  "exports": {
    ".": "./dist/api.js",
    "./engine": "./dist/engine.js",
    "./lib": "./dist/lib.js",
    "./live": "./dist/client/live.js",
    "./risk": "./dist/risk.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-api-map.mjs",
    "cli": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "nodemailer": "^7.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@types/node": "^25.9.5"
  },
  "engines": { "node": ">=20" },
  "author": "Zayd Khan (@ColdCooks / zaydiscold)",
  "license": "MIT"
}
